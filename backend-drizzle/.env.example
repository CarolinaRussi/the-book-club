DATABASE_URL=your_database_url_here
PORT=4001
JWT_SECRET=your_super_secret_jwt_key_here

# Google Calendar OAuth
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# GOOGLE_OAUTH_REDIRECT_URI=http://localhost:4001/api/auth/google/callback
# GOOGLE_OAUTH_SUCCESS_REDIRECT=http://localhost:5173/
# GOOGLE_OAUTH_ERROR_REDIRECT=http://localhost:5173/
# Chave 32 bytes: openssl rand -base64 32
GOOGLE_TOKEN_ENCRYPTION_KEY=

# CALENDAR_DEFAULT_TIMEZONE=America/Sao_Paulo
# GOOGLE_CALENDAR_MEETING_DURATION_MINUTES=120

CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret

# E-mail transacional (Resend) — reset de senha e notificações
# Dev: use onboarding@resend.dev como remetente até verificar entrelivros.com
RESEND_API_KEY=
EMAIL_FROM=Entrelivros <noreply@entrelivros.com>
FRONTEND_URL=http://localhost:5173
# Opcional: destinatário padrão para pnpm run email:test
# EMAIL_TO=seu@email.com
